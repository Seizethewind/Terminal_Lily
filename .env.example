# Copy to .env and fill in. Never commit .env.

# Your freellmapi router (OpenAI-compatible /v1 endpoint)
LILY_BASE_URL=http://127.0.0.1:3001/v1
LILY_API_KEY=freellmapi-your-unified-key

# Max think/act steps per message
LILY_MAX_STEPS=8

# Seconds to wait for the router before giving up
LILY_TIMEOUT=60

# Bearer key for the LilyAi MCP (see config/mcp_servers.toml). One key only.
MCP_API_KEYS=

# Optional: use another page that mimics DuckDuckGo's HTML search
# LILY_SEARCH_URL=

# Copy to .env and fill in. Never commit .env.
# Router URLs are built in (config/self.toml); only the keys go here.

# Key for the router (LilyAiApi dashboard -> API key)
LILY_API_KEY=

# Optional: override the built-in router URL (default is in config/settings.py)
# LILY_BASE_URL=

# Where Lily's workplace lives: she creates Terminal_Lily_Workplace inside this folder and
# keeps your projects there. Default is your home folder.
# LILY_WORKPLACE_DIR=/storage/emulated/0

# Max think/act steps per message
LILY_MAX_STEPS=8

# Seconds to wait for the router before giving up
LILY_TIMEOUT=60

# Bearer key for the LilyAi MCP (see config/mcp_servers.toml). One key only.
MCP_API_KEYS=

# Optional: use another page that mimics DuckDuckGo's HTML search
# LILY_SEARCH_URL=
